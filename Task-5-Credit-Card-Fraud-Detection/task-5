# Import pandas for handling the dataset
import pandas as pd

# Import numpy for numerical calculations
import numpy as np

# Import matplotlib for graphs
import matplotlib.pyplot as plt

# Import seaborn for data visualization
import seaborn as sns

# Import train_test_split to divide the dataset
from sklearn.model_selection import train_test_split

# Import StandardScaler for feature normalization
from sklearn.preprocessing import StandardScaler

# Import Logistic Regression
from sklearn.linear_model import LogisticRegression

# Import evaluation metrics
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report,
    confusion_matrix
)

print("Libraries imported successfully!")

# Load the credit card fraud dataset
df = pd.read_csv("creditcard.csv")

# Display the first 5 rows
df.head()

# Display the number of rows and columns
print("Dataset Shape:", df.shape)

# Display column names
print("\nColumn Names:")
print(df.columns.tolist())

# Display information about the dataset
print("\nDataset Information:")
df.info()

# Check the number of missing values in each column
missing_values = df.isnull().sum()

# Display missing values
print("Missing Values:")
print(missing_values)

# Count duplicate rows
duplicate_count = df.duplicated().sum()

# Display the number of duplicate rows
print("Number of duplicate rows:", duplicate_count)

# Count transactions in each class
class_counts = df["Class"].value_counts()

# Display the counts
print("Transaction Classes:")
print(class_counts)

# Create a bar graph
sns.countplot(data=df, x="Class")

# Add title and labels
plt.title("Genuine vs Fraudulent Transactions")
plt.xlabel("Class (0 = Genuine, 1 = Fraudulent)")
plt.ylabel("Number of Transactions")

# Display the graph
plt.show()

# Calculate the percentage of each class
class_percentage = df["Class"].value_counts(normalize=True) * 100

# Display percentages
print("Transaction Class Percentage:")
print(class_percentage)

# Separate the input features
X = df.drop("Class", axis=1)

# Select Class as the target variable
y = df["Class"]

# Display the feature data
print("Features:")
print(X.head())

# Display target values
print("\nTarget:")
print(y.head())

# Create a StandardScaler
scaler = StandardScaler()

# Normalize the Amount column
X["Amount"] = scaler.fit_transform(
    X[["Amount"]]
)

# Normalize the Time column
X["Time"] = scaler.fit_transform(
    X[["Time"]]
)

# Display the normalized data
X.head()

# Split the dataset into training and testing data
# 80% for training
# 20% for testing

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# Display dataset sizes
print("Training data:", X_train.shape)
print("Testing data:", X_test.shape)

# Create the Logistic Regression model
# class_weight="balanced" helps handle class imbalance

model = LogisticRegression(
    class_weight="balanced",
    max_iter=1000
)

# Train the model
model.fit(X_train, y_train)

print("Logistic Regression model trained successfully!")

# Predict the class of transactions in the test data
y_pred = model.predict(X_test)

# Display the first 20 predictions
print("First 20 Predictions:")
print(y_pred[:20])

# Calculate accuracy
accuracy = accuracy_score(y_test, y_pred)

# Display accuracy
print("Accuracy:", round(accuracy * 100, 2), "%")

# Calculate precision
precision = precision_score(y_test, y_pred)

# Calculate recall
recall = recall_score(y_test, y_pred)

# Calculate F1-score
f1 = f1_score(y_test, y_pred)

# Display the results
print("Model Evaluation")
print("-------------------------")
print("Precision:", round(precision, 4))
print("Recall:", round(recall, 4))
print("F1-Score:", round(f1, 4))

# Display the complete classification report
print("Classification Report:")
print(
    classification_report(
        y_test,
        y_pred,
        target_names=["Genuine", "Fraudulent"]
    )
)

# Calculate the confusion matrix
cm = confusion_matrix(y_test, y_pred)

# Create a heatmap
sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    xticklabels=["Genuine", "Fraudulent"],
    yticklabels=["Genuine", "Fraudulent"]
)

# Add title and labels
plt.title("Confusion Matrix - Credit Card Fraud Detection")
plt.xlabel("Predicted")
plt.ylabel("Actual")

# Display the graph
plt.show()

# Select one existing transaction from the test data
sample_transaction = X_test.iloc[[0]]

# Predict whether it is genuine or fraudulent
sample_prediction = model.predict(sample_transaction)

# Display the result
if sample_prediction[0] == 1:
    print("Prediction: FRAUDULENT TRANSACTION")
else:
    print("Prediction: GENUINE TRANSACTION")

# Display the final project summary

print("==========================================")
print("CREDIT CARD FRAUD DETECTION")
print("==========================================")

print("Machine Learning Algorithm: Logistic Regression")
print("Class Imbalance Handling: Balanced Class Weights")
print("Training Samples:", len(X_train))
print("Testing Samples:", len(X_test))

print("Accuracy:", round(accuracy * 100, 2), "%")
print("Precision:", round(precision, 4))
print("Recall:", round(recall, 4))
print("F1-Score:", round(f1, 4))

print("==========================================")
print("Project completed successfully!")
print("==========================================")
